# Optional: needed for OpenSanctions tools.
OPENSANCTIONS_API_KEY=

# Local defaults are already built into server.py.
# For Render, replace with your real service hostname, for example:
# MCP_ALLOWED_HOSTS=forensic-company-mcp.onrender.com,forensic-company-mcp.onrender.com:*
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*

# Origins allowed to call MCP from a browser/Expo Web frontend.
# Native React Native clients usually do not send a browser Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:19006
